# =============================================================================
# calendar-ics-mcp configuration
#
# Copy to `.env` for local development (the compose services load it).
# NEVER commit `.env` — ICS_URL works as a bearer credential for the calendar.
# =============================================================================

# Required. URL of the published ICS feed (Outlook / Exchange "reachcalendar").
# Treat as a secret: anyone with this URL can read the calendar.
ICS_URL=https://outlook.office365.com/owa/calendar/<calendar-id>/reachcalendar.ics

# Optional. IANA timezone used to interpret date queries and format output.
# Default: Europe/Prague
#TZ_DEFAULT=Europe/Prague

# Optional. In-memory cache TTL for the downloaded feed, in seconds.
# Default: 300
#CACHE_TTL_SECONDS=300

# Optional. Timeout for fetching the feed, in milliseconds.
# Default: 15000
#FETCH_TIMEOUT_MS=15000

# Optional. Set to serve MCP Streamable HTTP on this address instead of stdio.
# Also enables GET /healthz and the `--health` container probe.
#
# Leave this commented out here. Every compose service loads this file, so
# setting HTTP_BIND in .env silently turns the stdio `calendar-ics` service
# into an HTTP server too. The `calendar-ics-http` service sets it itself.
#HTTP_BIND=0.0.0.0:8590

# Optional. Require `Authorization: Bearer <token>` on POST /mcp in HTTP mode
# (/healthz stays unauthenticated for the container healthcheck). Unset means
# NO authentication — anyone who can reach the port can read the calendar.
# Treat the value as a secret, like ICS_URL.
#HTTP_BEARER_TOKEN=
